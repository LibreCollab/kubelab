{
  "name": "kubelab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kubelab/web dev",
    "build": "pnpm --filter @kubelab/web build",
    "preview": "pnpm --filter @kubelab/web preview",
    "lint": "biome check . && stylelint \"**/*.{css,scss}\"",
    "lint:fix": "biome check --write . && stylelint \"**/*.{css,scss}\" --fix",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "api:dev": "go -C apps/api run ./cmd/api",
    "api:test": "go -C apps/api test ./...",
    "api:build": "go -C apps/api build ./cmd/api",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm api:test && pnpm spec:validate",
    "spec:list": "openspec list --all",
    "spec:validate": "openspec validate --all",
    "audit:lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.0.0",
    "@fission-ai/openspec": "2.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
